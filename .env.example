# ============================================================
# ZENITH EMPIRE — Environment Variables
# انسخ لـ .env وعدّل القيم
# ⚠️ لا ترفع .env أبداً على GitHub
# ============================================================

# ─── Frontend (VITE_ = تظهر في المتصفح — عامة فقط) ──────────
VITE_ZENITH_ISSUER=G...         # المفتاح العام للمصدر (آمن)
VITE_STELLAR_NETWORK=mainnet    # mainnet | testnet

# ─── Backend فقط (بدون VITE_ = لا تصل للمتصفح أبداً) ────────
ZENITH_ISSUER=G...              # نفس المفتاح العام للمصدر
DISTRIBUTOR_SECRET=S...         # ⚠️ سري جداً — لخادم Vercel فقط
ISSUER_SECRET=S...              # ⚠️ سري جداً — للـ Admin API فقط
ADMIN_TOKEN=...                 # كلمة مرور لوحة Admin (اختر عشوائية قوية)
